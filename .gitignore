# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.output/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep credentials local and publish only the setup template.
.env*
!.env.local.example

# vercel
.vercel
.workflow/
.eve/
/app/.well-known/workflow/

# typescript
*.tsbuildinfo
next-env.d.ts
/.swc
