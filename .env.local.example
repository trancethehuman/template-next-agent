# Copy this file to .env.local, then fill in credentials for your own environment.
# .env.local is ignored by Git. Never commit a populated copy.

# Local AI Gateway calls, including TypeSafe Jev evaluation and the EVE agent.
# On Vercel, project OIDC can authenticate AI Gateway calls without this key.
AI_GATEWAY_API_KEY=

# Required before publishing an internet-facing demo. Give it a long random value.
# The demo's protected classification endpoints expect this as a bearer token.
DEMO_ACCESS_TOKEN=

# Optional Supabase starter clients. Leave both blank for the transaction demo.
# Find these values in your own Supabase project's Connect dialog.
# Never substitute a secret or service_role key for the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
