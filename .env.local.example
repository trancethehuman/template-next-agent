# Copy this file to .env.local, then fill in credentials for your own environment.
# .env.local is ignored by Git. Never commit a populated copy.

# Local AI Gateway calls, including TypeSafe Jev evaluation and the EVE agent.
# On Vercel, project OIDC can authenticate AI Gateway calls without this key.
AI_GATEWAY_API_KEY=

# Local Workflow World queue headroom for model calls that take over 30 seconds.
# This is a local runtime setting, not a credential and not needed on Vercel.
WORKFLOW_LOCAL_HEADERS_TIMEOUT_MS=90000
# Persistent local task/preference records, outside Next's disposable build output.
# next.config.ts selects the local World before the pinned adapter can overwrite
# this path. EVE sessions separately use .eve/.workflow-data. Do not set a local
# World or filesystem path on Vercel deployments; use Vercel's managed World.
WORKFLOW_LOCAL_DATA_DIR=.workflow-data

# Required before publishing an internet-facing demo. Give it a long random value.
# The demo's protected classification endpoints expect this as a bearer token.
DEMO_ACCESS_TOKEN=

# Optional Supabase starter clients. Leave both blank for the transaction demo.
# Find these values in your own Supabase project's Connect dialog.
# Never substitute a secret or service_role key for the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Assistant Google sign-in (Auth.js); distinct from Calendar permission.
# The web OAuth client needs /api/auth/callback/google as an exact redirect URI.
# Generate a fresh random AUTH_SECRET of at least 32 characters for this project.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Leave empty to allow any verified Google account. Optional Workspace domain
# restricts both Google's verified hosted-domain claim and the account email.
AUTH_GOOGLE_WORKSPACE_DOMAIN=
# Optional display name for this deployment, e.g. your organization name.
AUTH_WORKSPACE_NAME=
# Local canonical URL. Set the real HTTPS application origin on a deployment.
AUTH_URL=http://localhost:3000

# Optional assistant Calendar connector: exact UID from `vercel connect list`.
# Each verified Google session gets its own Connect subject and primary calendar.
# Subject ID and owner email come from the server session, never environment or browser input.
ASSISTANT_GOOGLE_CONNECTOR=
# Default read-only. Exact `true` additionally requests calendar.events.owned.
# Each signed-in user must consent independently and approve each exact event proposal.
ASSISTANT_CALENDAR_WRITE_ENABLED=false

# Optional trusted Next.js origin for EVE's protected task API bridge.
# Defaults to http://127.0.0.1:3000 locally and https://${VERCEL_URL} on Vercel.
# Set this for a different local Next port or self-hosted HTTPS app; no URL path.
ASSISTANT_APP_ORIGIN=
# VERCEL_OIDC_TOKEN is supplied by `vercel env pull` after linking the project.
# Never copy an OIDC token from another project or commit it to this template.

# Assistant cloud browser (Vercel Sandbox). On by default; set to false to remove
# it from a deployment. Locally the sandbox SDK authenticates with the same
# VERCEL_OIDC_TOKEN from `vercel env pull`; on Vercel it uses project OIDC.
# Each signed-in user gets one persistent sandbox. The live view password is
# derived from AUTH_SECRET, so no extra secret is needed.
ASSISTANT_BROWSER_ENABLED=true
# Optional: the brief model when no chat choice applies. Defaults to openai/gpt-6.1-terra.
ASSISTANT_MODEL=
